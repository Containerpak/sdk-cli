{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Command Line SDK",
  "description": "The search, text and archive tools a development environment is expected to have.",
  "version": "1.0.0",
  "image": "ghcr.io/containerpak/sdk-cli@sha256:123f7270d72aadd9c25b87d44ee0fc700b667c9958822fff922df444709f5f4f",
  "binaries": [
    "/usr/bin/jq",
    "/usr/bin/rg",
    "/usr/bin/fd",
    "/usr/bin/fzf",
    "/usr/bin/shellcheck",
    "/usr/bin/sqlite3",
    "/usr/bin/tree",
    "/usr/bin/curl",
    "/usr/bin/wget",
    "/usr/bin/unzip",
    "/usr/bin/zip",
    "/usr/bin/xz",
    "/usr/bin/zstd"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "cli",
    "slot": "sdk.cli",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/usr/bin"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filePicker": {},
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
